% indonesian.lbx
% Localization file for Indonesian language in biblatex-chicago
% Date: 2024-11-14

\ProvidesFile{indonesian.lbx}[2024/11/14 Indonesian language file for biblatex-chicago]

\InheritBibliographyExtras{english}
\InheritCitationExtras{english}

\DeclareBibliographyStrings{%
  inherit          = {english},
  % General strings
  and              = {{dan}{dan}},
  andothers        = {{dkk}{dkk\adddot}},
  editor           = {{editor}{editor}},
  editors          = {{editor-editor}{editor-editor}},
  byeditor         = {{oleh editor}{oleh editor}},
  translator       = {{penerjemah}{penerjemah}},
  translators      = {{penerjemah-penerjemah}{penerjemah-penerjemah}},
  bytranslator     = {{oleh penerjemah}{oleh penerjemah}},
  edition          = {{edisi}{edisi}},
  volume           = {{jilid}{jilid}},
  volumes          = {{jilid-jilid}{jilid-jilid}},
  number           = {{nomor}{no\adddot}},
  numbers          = {{nomor-nomor}{no-no\adddot}},
  series           = {{seri}{seri}},
  chapter          = {{bab}{bab}},
  chapters         = {{bab-bab}{bab-bab}},
  type             = {{tipe}{tipe}},
  types            = {{tipe-tipe}{tipe-tipe}},
  pages            = {{halaman}{hlm\adddot}},
  page             = {{halaman}{hlm\adddot}},
  % Date strings
  date             = {{tanggal}{tgl\adddot}},
  month            = {{bulan}{bln\adddot}},
  year             = {{tahun}{th\adddot}},
  % Thesis types
  mathesis         = {{Tesis Magister}{Tesis Magister}},
  phdthesis        = {{Disertasi Doktor}{Disertasi Doktor}},
  % Miscellaneous
  in               = {{dalam}{dalam}},
  edition          = {{edisi}{edisi}},
  editor           = {{editor}{editor}},
  % URLs and DOIs
  urlseen          = {{diakses pada}{diakses pada}},
  url              = {{URL}{URL}},
  doi              = {{DOI}{DOI}},
  % Months (if needed)
  january          = {{Januari}{Jan\adddot}},
  february         = {{Februari}{Feb\adddot}},
  march            = {{Maret}{Mar\adddot}},
  april            = {{April}{Apr\adddot}},
  may              = {{Mei}{Mei}},
  june             = {{Juni}{Jun\adddot}},
  july             = {{Juli}{Jul\adddot}},
  august           = {{Agustus}{Agu\adddot}},
  september        = {{September}{Sep\adddot}},
  october          = {{Oktober}{Okt\adddot}},
  november         = {{November}{Nov\adddot}},
  december         = {{Desember}{Des\adddot}},
}

\endinput

